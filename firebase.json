{
  "functions": [
    {
      "codebase": "pagina",
      "source": ".",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        ".github",
        ".firebase",
        "panel",
        "scripts",
        "*.md",
        "*.log",
        ".env.example",
        "railway.json"
      ]
    },
    {
      "codebase": "panel",
      "source": "panel",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        "*.md",
        "*.log",
        ".env.example",
        "railway.json"
      ]
    }
  ],
  "hosting": [
    {
      "target": "pagina",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "script.js",
        "politica-de-privacidad/index.html"
      ],
      "rewrites": [
        {
          "source": "/api/**",
          "function": {
            "functionId": "pagina",
            "region": "us-east1"
          }
        },
        {
          "source": "/script.js",
          "function": {
            "functionId": "pagina",
            "region": "us-east1"
          }
        },
        {
          "source": "/politica-de-privacidad{,/}",
          "function": {
            "functionId": "pagina",
            "region": "us-east1"
          }
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=()"
            },
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        }
      ]
    },
    {
      "target": "panel",
      "public": "panel/public",
      "rewrites": [
        {
          "source": "**",
          "function": {
            "functionId": "panel",
            "region": "us-east1"
          }
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            }
          ]
        }
      ]
    }
  ]
}
